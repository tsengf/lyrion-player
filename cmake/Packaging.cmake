# Native installation packages. Enable with -DPLAYER_BUILD_PACKAGES=ON.
if(NOT PLAYER_BUILD_TRAY)
  message(FATAL_ERROR "Packaging requires the tray app; configure with -DPLAYER_BUILD_TRAY=ON")
endif()

set(CPACK_PACKAGE_NAME "Lyrion Player")
set(CPACK_PACKAGE_VENDOR "Lyrion Player contributors")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "A native Lyrion Music Server player")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/tsengf/lyrion-player")
set(CPACK_PACKAGE_CONTACT "https://github.com/tsengf/lyrion-player/issues")
set(CPACK_RESOURCE_FILE_README "${PROJECT_SOURCE_DIR}/README.md")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/COPYING")
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_BINARY_DIR}/packages")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "Lyrion Player")
set(CPACK_VERBATIM_VARIABLES YES)
# Package the existing deployment component, including codec/runtime libraries and
# licenses. Exclude the development CLI install and all test executables.
set(CPACK_INSTALL_CMAKE_PROJECTS "${PROJECT_BINARY_DIR};${PROJECT_NAME};Tray;/")
set(CPACK_MONOLITHIC_INSTALL ON)

set(package_arch "${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
  list(LENGTH CMAKE_OSX_ARCHITECTURES arch_count)
  if(arch_count GREATER 1)
    set(package_arch universal)
  else()
    set(package_arch "${CMAKE_OSX_ARCHITECTURES}")
  endif()
elseif(WIN32)
  if(CMAKE_GENERATOR_PLATFORM MATCHES "[Aa][Rr][Mm]64" OR
     CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "ARM64")
    set(package_arch arm64)
  elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(package_arch x86_64)
  else()
    set(package_arch x86)
  endif()
endif()
set(CPACK_PACKAGE_FILE_NAME "LyrionPlayer-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${package_arch}")

if(APPLE)
  set(CPACK_GENERATOR DragNDrop)
  set(CPACK_DMG_VOLUME_NAME "Lyrion Player ${PROJECT_VERSION}")
  set(CPACK_DMG_FORMAT UDZO)
  set(CPACK_DMG_SLA_USE_RESOURCE_FILE_LICENSE OFF)
elseif(WIN32)
  set(CPACK_GENERATOR NSIS)
  set(CPACK_NSIS_DISPLAY_NAME "Lyrion Player")
  set(CPACK_NSIS_PACKAGE_NAME "Lyrion Player")
  set(CPACK_NSIS_URL_INFO_ABOUT "${CPACK_PACKAGE_HOMEPAGE_URL}")
  set(CPACK_NSIS_HELP_LINK "${CPACK_PACKAGE_CONTACT}")
  set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
  set(CPACK_NSIS_MODIFY_PATH OFF)
  set(CPACK_PACKAGE_EXECUTABLES "Lyrion Player;Lyrion Player")
  set(CPACK_NSIS_EXECUTABLES_DIRECTORY ".")
  set(CPACK_NSIS_MUI_FINISHPAGE_RUN "Lyrion Player.exe")
endif()

include(CPack)
